---
import { contact, footerNav } from '../data/site';
---

<section class="footer-cta section-pad">
  <div class="cta-lockup">
    <h2 class="font-display lets">Let's</h2>
    <div class="cta-mid">
      <img
        src="/images/staging/crosswith/crosswith-03.jpg"
        alt=""
        width="420"
        height="240"
      />
      <a class="contact-link" href="/contact">
        <span class="contact-arrow" aria-hidden="true">↗</span>
        Contact
      </a>
    </div>
    <h2 class="font-display collab">collaborate</h2>
  </div>
</section>

<footer class="site-footer section-pad">
  <div class="socials">
    {
      contact.socials.map((s) => (
        <a href={s.href} target="_blank" rel="noreferrer">
          {s.label}
        </a>
      ))
    }
  </div>

  <div class="meta">
    <a href="#">{contact.email}</a>
    <a href={contact.phoneHref}>{contact.phone}</a>
    <a href={contact.mapsUrl}>
      {contact.addressLine1}
      <br />
      {contact.addressLine2}
    </a>
  </div>

  <div class="footer-bottom">
    <nav class="footer-nav">
      {
        footerNav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
    <p class="copy">{contact.copyright}</p>
  </div>
</footer>

<style>
  .footer-cta {
    padding-block: 6.5rem 3.25rem;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .cta-lockup {
    display: grid;
    justify-items: center;
    text-align: center;
    position: relative;
  }

  .lets,
  .collab {
    margin: 0;
    font-size: clamp(4rem, 9.8vw, 8.75rem);
    line-height: 0.82;
    position: relative;
    z-index: 1;
  }

  .cta-mid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.35rem;
    margin-block: -1.15rem;
    position: relative;
    z-index: 2;
  }

  .cta-mid img {
    width: min(20rem, 42vw);
    height: 7.4rem;
    object-fit: cover;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .contact-arrow {
    color: var(--accent);
  }

  .site-footer {
    padding-bottom: 2rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .meta {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 2.25rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
  }

  .footer-nav a,
  .copy {
    font-size: 0.75rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 700px) {
    .cta-mid {
      flex-direction: column;
      margin-block: 0.75rem;
    }

    .cta-mid img {
      width: min(18rem, 78vw);
      height: 6.5rem;
    }

    .lets,
    .collab {
      font-size: clamp(3.6rem, 18vw, 5.5rem);
    }
  }
</style>
