---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyStats, coreStandards, team } from '../data/company';

// Cursor trail images: Nova's own staged client work.
const trailImages = [
  '/images/staging/crosswith/crosswith-01.jpg',
  '/images/staging/freeperiod/freeperiod-02.png',
  '/images/staging/crosswith/crosswith-05.jpg',
  '/images/staging/betterbuilt/site/bb-site-01.png',
  '/images/staging/crosswith/crosswith-06.jpg',
  '/images/staging/freeperiod/freeperiod-03.png',
];
---

<BaseLayout title="Company — Nova Industries" activePath="/company">
  <section class="hero section-pad" data-trail={JSON.stringify(trailImages)}>
    <p class="eyebrow" data-appear style="--ay:170;--ad:.3">WHO</p>
    <h1 class="font-display">
      <span class="mask"><span class="line" data-appear style="--ay:170;--ad:.5">Creative</span></span>
      <span class="mask"><span class="line" data-appear style="--ay:170;--ad:.5">Systems</span></span>
    </h1>
    <p class="lede" data-appear style="--ay:170;--ad:.9">
      A creative agency built on specialisation, systems, and craft.
    </p>
    <p class="body" data-appear style="--ay:170;--ad:.9">
      We are a specialist creative agency working at the intersection of brand, design, and
      technology. We partner with founders, product teams, and growing companies to build
      identities and experiences that last.
    </p>
  </section>

  <section class="stats section-pad">
    <div class="reveal-shell" data-rise>
      {
        companyStats.map((s) => (
          <article>
            <p class="font-display value" data-count={`${s.from},${s.to}`} data-suffix={s.suffix}>{s.from}{s.suffix}</p>
            <p class="label">{s.label}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="powerhouse section-pad">
    <div class="reveal-shell">
      <h2 class="font-display" data-flip>
        We're a
        <br />
        Creative
        <br />
        Powerhouse
      </h2>
      <blockquote data-rise>
        In a world where everyone is trying to do everything, we choose to specialise in the
        creative design, marketing and tech industries.
      </blockquote>
      <p class="by">Neatian Meyal</p>
      <p class="role">CEO, Nova Industries tech agency</p>
    </div>
  </section>

  <section class="standards section-pad">
    <div class="reveal-shell">
      <h2 class="font-display mask"><span class="line" data-rise>Core Standards</span></h2>
      <div class="grid" data-rise>
        {
          coreStandards.map((s) => (
            <article>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="team section-pad">
    <div class="reveal-shell">
      <h2 class="font-display mask"><span class="line" data-rise>Meet the Team</span></h2>
      <div class="team-grid" data-rise>
        {
          team.map((m) => (
            <article>
              <div class="avatar" aria-hidden="true">{m.name.slice(0, 1)}</div>
              <h3>{m.name}</h3>
              <p>{m.role}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Framer "Cursor Image Trail" (desktop >= 1200): a 200x250 image spawns on the cursor every
  // 163.45px of travel (frequency 10), cycling in order; springs in from blur/scale .8, holds
  // 0.5s, springs out (k500 d60).
  import { animate } from 'motion';

  const hero = document.querySelector<HTMLElement>('[data-trail]');
  if (hero && matchMedia('(min-width: 1200px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const imgs: string[] = JSON.parse(hero.dataset.trail!);
    imgs.forEach((src) => (new Image().src = src));
    const spring = { type: 'spring' as const, stiffness: 500, damping: 60, mass: 1 };
    let last: { x: number; y: number } | null = null;
    let i = 0;
    hero.addEventListener('mousemove', (e) => {
      const r = hero.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      if (last && Math.hypot(x - last.x, y - last.y) <= 163.45) return;
      last = { x, y };
      const el = document.createElement('div');
      el.className = 'trail-img';
      el.style.cssText = `left:${x - 100}px;top:${y - 125}px;background-image:url(${imgs[i]})`;
      i = (i + 1) % imgs.length;
      hero.append(el);
      animate(el, { opacity: [0, 1], scale: [0.8, 1], filter: ['blur(10px)', 'blur(0px)'] }, spring);
      setTimeout(() => animate(el, { opacity: 0, scale: 0.8, filter: 'blur(10px)' }, spring).then(() => el.remove()), 500);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: 2.5rem 3.5rem;
  }

  .hero :global(.trail-img) {
    position: absolute;
    z-index: 2;
    width: 200px;
    height: 250px;
    background: center / cover no-repeat;
    pointer-events: none;
  }

  .powerhouse {
    perspective: 1400px;
  }

  .hero h1 {
    margin: 0.35rem 0 1.25rem;
    font-size: clamp(4.75rem, 18vw, 13rem);
    line-height: 0.76;
    display: grid;
  }

  .lede {
    max-width: 28rem;
    font-size: 1.15rem;
    margin: 0 0 0.85rem;
  }

  .body {
    max-width: 40rem;
    color: var(--muted);
    line-height: 1.55;
    font-size: 0.9rem;
  }

  .stats :global(.reveal-shell) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .stats {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .value {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 0.9;
  }

  .label {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .powerhouse {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
  }

  .powerhouse h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.8rem, 9vw, 6rem);
    line-height: 0.9;
  }

  blockquote {
    margin: 0;
    max-width: 40rem;
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .by {
    margin: 1.25rem 0 0.15rem;
    font-weight: 600;
  }

  .role {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .standards,
  .team {
    padding-block: 3.5rem;
    border-top: 1px solid var(--line);
  }

  .standards h2,
  .team h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 0.9;
  }

  .grid,
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .grid h3,
  .team-grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .grid p,
  .team-grid p {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
    font-size: 0.9rem;
  }

  .avatar {
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: #171717;
    border: 1px solid var(--line);
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 3rem;
  }

  @media (max-width: 900px) {
    .stats :global(.reveal-shell),
    .grid,
    .team-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .stats :global(.reveal-shell),
    .grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
