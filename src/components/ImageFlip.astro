---
// Framer "Image Flip": four bands wipe off the image shortly after load, and the image
// zooms to 1.2 while the pointer is over it (spring 0.8s, bounce 0.1).
interface Props {
  src: string;
  alt: string;
  class?: string;
  style?: string;
}
const { src, alt, class: cls, style } = Astro.props;
---

<div class:list={['flip', cls]} style={style}>
  <div class="flip-img">
    <img src={src} alt={alt} loading="lazy" />
    <div class="blinds" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </div>
</div>

<style>
  .flip {
    overflow: hidden;
    background: #151515;
  }

  .flip-img {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform var(--dur-zoom) var(--ease-zoom);
  }

  .flip:hover .flip-img {
    transform: scale(1.2);
  }

  .flip-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-pos, center);
  }

  .blinds {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .blinds i {
    flex: 1;
    background: var(--bg);
    transform-origin: 50% 100%;
    animation: blind var(--dur-zoom) var(--ease-zoom) 0.4s both;
  }

  @keyframes blind {
    from {
      transform: scaleY(1.01);
    }
    to {
      transform: scaleY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blinds {
      display: none;
    }
  }
</style>
