---
// Framer "Nav Item" (AV1wFq83v): flex row, 4px gap. Brackets mount instantly;
// spacers spring to one glyph + 4px so the label FLIPs (Primary: 0.4s bounce 0.1;
// Footer: 0.6s bounce 0, delay 0.1s). Color flips are instant (plain :hover /
// current-link tokens). In-flow spacers keep centered mobile items balanced.
interface Props {
  href: string;
  label: string;
  active?: boolean;
  size?: 'sm' | 'lg';
  external?: boolean;
  appear?: boolean;
}
const { href, label, active = false, size = 'sm', external = false, appear = false } = Astro.props;
---

<a
  href={href}
  class:list={['nav-item', size, { active }]}
  data-appear={appear ? 'tween' : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
>
  <span class="sp" aria-hidden="true"></span>
  <span class="br l" aria-hidden="true">[</span>
  <span class="label">{label}</span>
  <span class="br r" aria-hidden="true">]</span>
  <span class="sp" aria-hidden="true"></span>
</a>

<style>
  .nav-item {
    --bw: 0.4em;
    --shift: calc(var(--bw) + 4px);
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sm {
    font-size: 14px;
    line-height: 20px;
    color: #808080;
  }

  .lg {
    font-size: 28px;
    line-height: 36px;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .active,
  .nav-item:hover,
  .nav-item:focus-visible {
    color: #fff;
  }

  .sp {
    flex: none;
    width: 0;
    transition: width var(--dur-nav) var(--ease-nav);
  }

  .lg .sp {
    transition: width var(--dur-nav-footer) var(--ease-nav-footer) 0.1s;
  }

  .label {
    flex: none;
  }

  .br {
    position: absolute;
    top: 0;
    width: var(--bw);
    overflow: hidden;
    visibility: hidden;
  }

  .br.l {
    left: 0;
  }

  .br.r {
    right: 0;
    text-align: right;
  }

  .nav-item:hover .br,
  .nav-item:focus-visible .br {
    visibility: visible;
  }

  .nav-item:hover .sp,
  .nav-item:focus-visible .sp {
    width: var(--shift);
  }
</style>
