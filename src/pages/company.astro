---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal';
import { companyStats, coreStandards, team } from '../data/company';
---

<BaseLayout title="Company — Nova Industries" activePath="/company">
  <section class="hero section-pad">
    <p class="eyebrow">WHO</p>
    <h1 class="font-display">
      <span>Creative</span>
      <span>Systems</span>
    </h1>
    <p class="lede">
      A creative agency built on specialisation, systems, and craft.
    </p>
    <p class="body">
      We are a specialist creative agency working at the intersection of brand, design, and
      technology. We partner with founders, product teams, and growing companies to build
      identities and experiences that last.
    </p>
  </section>

  <section class="stats section-pad">
    <Reveal client:visible className="reveal-shell">
      {
        companyStats.map((s) => (
          <article>
            <p class="font-display value">{s.value}</p>
            <p class="label">{s.label}</p>
          </article>
        ))
      }
    </Reveal>
  </section>

  <section class="powerhouse section-pad">
    <Reveal client:visible className="reveal-shell">
      <h2 class="font-display">
        We're a
        <br />
        Creative
        <br />
        Powerhouse
      </h2>
      <blockquote>
        In a world where everyone is trying to do everything, we choose to specialise in the
        creative design, marketing and tech industries.
      </blockquote>
      <p class="by">Neatian Meyal</p>
      <p class="role">CEO, Nova Industries tech agency</p>
    </Reveal>
  </section>

  <section class="standards section-pad">
    <Reveal client:visible className="reveal-shell">
      <h2 class="font-display">Core Standards</h2>
      <div class="grid">
        {
          coreStandards.map((s) => (
            <article>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
    </Reveal>
  </section>

  <section class="team section-pad">
    <Reveal client:visible className="reveal-shell">
      <h2 class="font-display">Meet the Team</h2>
      <div class="team-grid">
        {
          team.map((m) => (
            <article>
              <div class="avatar" aria-hidden="true">{m.name.slice(0, 1)}</div>
              <h3>{m.name}</h3>
              <p>{m.role}</p>
            </article>
          ))
        }
      </div>
    </Reveal>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 2.5rem 3.5rem;
  }

  .hero h1 {
    margin: 0.35rem 0 1.25rem;
    font-size: clamp(4.75rem, 18vw, 13rem);
    line-height: 0.76;
    display: grid;
  }

  .lede {
    max-width: 28rem;
    font-size: 1.15rem;
    margin: 0 0 0.85rem;
  }

  .body {
    max-width: 40rem;
    color: var(--muted);
    line-height: 1.55;
    font-size: 0.9rem;
  }

  .stats :global(.reveal-shell) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .stats {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .value {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 0.9;
  }

  .label {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .powerhouse {
    padding-block: 4rem;
    border-top: 1px solid var(--line);
  }

  .powerhouse h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.8rem, 9vw, 6rem);
    line-height: 0.9;
  }

  blockquote {
    margin: 0;
    max-width: 40rem;
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .by {
    margin: 1.25rem 0 0.15rem;
    font-weight: 600;
  }

  .role {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .standards,
  .team {
    padding-block: 3.5rem;
    border-top: 1px solid var(--line);
  }

  .standards h2,
  .team h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 0.9;
  }

  .grid,
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .grid h3,
  .team-grid h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }

  .grid p,
  .team-grid p {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
    font-size: 0.9rem;
  }

  .avatar {
    width: 100%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: #171717;
    border: 1px solid var(--line);
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-size: 3rem;
  }

  @media (max-width: 900px) {
    .stats :global(.reveal-shell),
    .grid,
    .team-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .stats :global(.reveal-shell),
    .grid,
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
