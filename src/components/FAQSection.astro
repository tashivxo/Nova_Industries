---
import { faqs } from '../data/faqs';
---

<section class="faq section-pad" id="faq">
  <div class="faq-head">
    <h2 class="faq-title mask"><span class="line" data-rise>FAQ</span></h2>
    <p class="faq-sub" data-rise>Clear Answers. No Guesswork.</p>
  </div>
  <div class="faq-list" data-rise data-faq>
    {
      faqs.map((item, i) => (
        <div class="faq-item">
          <button type="button" class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`}>
            {item.question}
          </button>
          <div class="faq-a" id={`faq-a-${i}`}>
            <div>
              <p>{item.answer}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Framer FAQ: one question open at a time; clicking the open one closes it.
  for (const list of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    const items = [...list.querySelectorAll<HTMLElement>('.faq-item')];
    for (const item of items) {
      // The whole row is the hit area (Framer: cursor pointer on the Question); the button
      // inside keeps it keyboard-accessible and its click bubbles here.
      item.addEventListener('click', () => {
        const opening = !item.classList.contains('open');
        for (const other of items) {
          other.classList.toggle('open', opening && other === item);
          other.querySelector('.faq-q')!.setAttribute('aria-expanded', String(opening && other === item));
        }
      });
    }
  }
</script>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding-block: 200px 0;
  }

  .faq-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 140px;
    line-height: 127px;
    font-weight: 600;
    letter-spacing: -7px;
    text-transform: uppercase;
  }

  .faq-sub {
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 24px;
    color: var(--muted);
  }

  .faq-item {
    padding-bottom: 32px;
    border-top: 1px solid #242424;
    cursor: pointer;
  }

  .faq-item:last-child {
    border-bottom: 1px solid #242424;
  }

  .faq-q {
    display: block;
    width: 100%;
    padding: 32px 0 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    font-size: 20px;
    line-height: 28px;
    text-align: left;
    cursor: pointer;
  }

  /* Height springs open/closed (0.4s, bounce 0.2); the answer never fades. */
  .faq-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-card) var(--ease-card);
  }

  .faq-a > div {
    overflow: hidden;
  }

  .faq-item.open .faq-a {
    grid-template-rows: 1fr;
  }

  .faq-a p {
    margin: 12px 0 0;
    max-width: 456px;
    font-size: 16px;
    line-height: 24px;
    color: #808080;
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      padding-block: 100px 0;
    }

    .faq-title {
      font-size: 88px;
      line-height: 80px;
      letter-spacing: -4px;
    }

    .faq-item {
      padding-bottom: 24px;
    }

    .faq-q {
      padding-top: 24px;
    }
  }
</style>
