---
import { contact, footerNav } from '../data/site';
import NavItem from './NavItem.astro';

const arrow =
  '<svg viewBox="0 0 11.25 11.25"><path d="M 11.25 0.625 L 11.25 8.75 C 11.25 9.095 10.97 9.375 10.625 9.375 C 10.28 9.375 10 9.095 10 8.75 L 10 2.134 L 1.068 11.067 C 0.824 11.311 0.428 11.312 0.183 11.067 C -0.061 10.823 -0.061 10.427 0.183 10.183 L 9.117 1.25 L 2.5 1.25 C 2.155 1.25 1.875 0.97 1.875 0.625 C 1.875 0.28 2.155 0 2.5 0 L 10.625 0 C 10.97 0 11.25 0.28 11.25 0.625 Z" /></svg>';
---

<section class="footer-cta" data-cta>
  <div class="cta-sticky">
    <div class="cta-lines" aria-hidden="true"><i></i><i></i><i></i></div>
    <div
      class="cta-lockup"
      data-scrub-min="1200"
      data-scrub-spring="none"
      data-scrub='[{"at":0,"v":{"scale":0.5,"opacity":0.5}},{"at":"end","v":{}}]'
    >
      <h2 class="cta-word">Let's</h2>
      <div class="cta-mid">
        <div class="cta-video">
          <video src="/images/hero/hero-loop.mp4" autoplay muted loop playsinline preload="metadata" data-inview-play></video>
        </div>
        <a class="cta-contact" href="/contact">
          <span class="ca l" aria-hidden="true" set:html={arrow} />
          <span class="ct">Contact</span>
          <span class="ca r" aria-hidden="true" set:html={arrow} />
        </a>
      </div>
      <h2 class="cta-word">collaborate</h2>
    </div>
  </div>
</section>

<footer class="site-footer section-pad" data-reveal style="--ry:50;--rdamp:50;--rt:.5">
  <div class="f-left">
    <nav class="socials" aria-label="Social">
      {contact.socials.map((s) => <NavItem href={s.href} label={s.label} external />)}
    </nav>
    <address class="f-contact">
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={contact.phoneHref}>{contact.phone}</a>
      <a href={contact.mapsUrl}>
        {contact.addressLine1}
        <br />
        {contact.addressLine2}
      </a>
    </address>
  </div>
  <nav class="f-nav" aria-label="Footer">
    {footerNav.map((item) => <NavItem href={item.href} label={item.label} size="lg" />)}
  </nav>
  <p class="copy">{contact.copyright}</p>
</footer>

<script>
  // Framer CTA override: once the section above has scrolled fully past, the video opens to
  // 25vh (1.2s) and the hairlines fade in; it closes again when that section comes back.
  const cta = document.querySelector<HTMLElement>('[data-cta]');
  // Astro renders component <script>s in place, so skip them to find the real section above.
  let prev = cta?.previousElementSibling;
  while (prev && ['SCRIPT', 'STYLE', 'LINK'].includes(prev.tagName)) prev = prev.previousElementSibling;
  if (cta && prev) {
    new IntersectionObserver(([e]) => {
      cta.classList.toggle('open', !e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(prev);
  }
</script>

<style>
  .footer-cta {
    position: relative;
  }

  .cta-sticky {
    position: relative;
    overflow: clip;
    padding-block: 100px;
  }

  .cta-lockup {
    position: relative;
    width: min(790px, 100%);
    margin-inline: auto;
    z-index: 1;
  }

  .cta-word {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(64px, 9.7vw, 140px);
    line-height: 0.907;
    font-weight: 600;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .cta-mid {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-left: 9px;
  }

  .cta-video {
    width: 400px;
    max-width: 60%;
    height: 225px;
    overflow: hidden;
  }

  .cta-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-lines i {
    position: absolute;
    left: -100%;
    top: 50%;
    width: 300%;
    height: 1px;
    background: #242424;
    opacity: 0;
    transition:
      opacity 0.5s ease,
      translate 0.5s ease;
  }

  .cta-lines i:nth-child(1) {
    translate: 0 -80px;
  }

  .cta-lines i:nth-child(2) {
    rotate: -18deg;
  }

  .cta-lines i:nth-child(3) {
    rotate: 17deg;
  }

  .open .cta-lines i {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
      translate 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .open .cta-lines i:nth-child(2) {
    transition-delay: 0.25s;
  }

  .open .cta-lines i:nth-child(3) {
    transition-delay: 0.5s;
  }

  /* Contact Button (same as the header): arrow swaps sides, text slides 21px, spring k400 d40. */
  .cta-contact {
    position: relative;
    display: inline-block;
    padding-left: 21px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .ct {
    display: inline-block;
    transition: transform var(--dur-contact) var(--ease-contact);
  }

  .ca {
    position: absolute;
    top: 4px;
    width: 11px;
    height: 12px;
    color: #ff531a;
  }

  .ca :global(svg) {
    display: block;
    width: 11px;
    height: 12px;
    fill: currentColor;
  }

  .ca.l {
    left: 0;
  }

  .ca.r {
    left: calc(100% - 11px);
    visibility: hidden;
  }

  .cta-contact:hover .ct {
    transform: translateX(-21px);
  }

  .cta-contact:hover .ca.l {
    visibility: hidden;
  }

  .cta-contact:hover .ca.r {
    visibility: visible;
  }

  /* Desktop: Framer pins the lockup 180px down for 150vh and opens the video on cue. */
  @media (min-width: 1200px) {
    .footer-cta {
      height: 150vh;
    }

    .cta-sticky {
      position: sticky;
      top: 180px;
      padding-block: 0;
    }

    .cta-video {
      height: 0;
      transition: height 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .open .cta-video {
      height: 25vh;
    }
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr 600px;
    grid-template-rows: auto auto;
    column-gap: 2rem;
    padding-block: 60px 20px;
  }

  .f-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
  }

  .socials {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .f-contact {
    display: grid;
    gap: 10px;
    font-style: normal;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
  }

  /* Framer: white -> #ff531a with no transition. */
  .f-contact a:hover {
    color: #ff531a;
  }

  .f-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
  }

  .copy {
    grid-column: 1 / -1;
    margin: 180px 0 0;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .site-footer {
      grid-template-columns: 1fr;
      row-gap: 3rem;
    }

    .f-nav {
      gap: 24px;
    }

    .copy {
      margin-top: 1rem;
    }

    .cta-mid {
      flex-wrap: wrap;
      padding-left: 0;
    }

    .cta-video {
      max-width: 100%;
    }
  }
</style>
