---
import { navItems, brand } from '../data/site';
import NavItem from './NavItem.astro';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
// Framer Contact Button glyph: filled 11.25² arrow, drawn 11×12, #ff531a.
const arrow =
  '<svg viewBox="0 0 11.25 11.25"><path d="M 11.25 0.625 L 11.25 8.75 C 11.25 9.095 10.97 9.375 10.625 9.375 C 10.28 9.375 10 9.095 10 8.75 L 10 2.134 L 1.068 11.067 C 0.824 11.311 0.428 11.312 0.183 11.067 C -0.061 10.823 -0.061 10.427 0.183 10.183 L 9.117 1.25 L 2.5 1.25 C 2.155 1.25 1.875 0.97 1.875 0.625 C 1.875 0.28 2.155 0 2.5 0 L 10.625 0 C 10.97 0 11.25 0.28 11.25 0.625 Z" /></svg>';

function isActive(href: string, path: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="site-header" data-appear style="--ay:170;--ad:.3">
  <nav class="site-nav" aria-label="Primary">
    {navItems.map((item) => <NavItem href={item.href} label={item.label} active={isActive(item.href, activePath)} appear />)}
  </nav>

  <a href="/" class="wordmark" aria-label={brand.name}>
    <span class="mark" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </span>
    <span class="wordmark-text">{brand.name}</span>
  </a>

  <a href="/contact" class="contact-cta">
    <span class="ca l" aria-hidden="true" set:html={arrow} />
    <span class="ct">Contact</span>
    <span class="ca r" aria-hidden="true" set:html={arrow} />
  </a>

  <button type="button" class="mobile-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    <svg class="i-open" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 .7h20M0 6.8h20M0 12.9h20" /></svg>
    <svg class="i-close" viewBox="0 0 20 14" aria-hidden="true"><path d="M3 0l14 14M17 0 3 14" /></svg>
  </button>

  <div class="mobile-drawer" id="mobile-menu">
    <nav aria-label="Mobile">
      {
        navItems.map((item) => (
          <NavItem href={item.href} label={item.label} active={isActive(item.href, activePath)} />
        ))
      }
      <NavItem href="/contact" label="Contact" active={isActive('/contact', activePath)} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    /* Framer template overlay: absolute top, z-index 10. Hero video is z-index 10
       later in the tree so the expand covers chrome; we sit just under the lockup. */
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    padding: 1.75rem var(--page-x) 0;
    pointer-events: none;
    overflow: visible;
  }

  .site-header > * {
    pointer-events: auto;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    overflow: visible;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: center;
    margin-top: 0.1rem;
  }

  .wordmark-text {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Framer Contact Button: flex row, 10px gap, 11px arrow. Arrows mount/unmount
     instantly; the label springs 21px (11+10) with k400 d40. Right-aligned so the
     trailing edge stays put. */
  .contact-cta {
    justify-self: end;
    position: relative;
    display: inline-block;
    padding-left: 21px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .ct {
    display: inline-block;
    transition: transform var(--dur-contact) var(--ease-contact);
  }

  .ca {
    position: absolute;
    top: 4px;
    width: 11px;
    height: 12px;
    color: #ff531a;
  }

  .ca :global(svg) {
    display: block;
    width: 11px;
    height: 12px;
    fill: currentColor;
  }

  .ca.l {
    left: 0;
  }

  .ca.r {
    left: calc(100% - 11px);
    visibility: hidden;
  }

  .contact-cta:hover .ct,
  .contact-cta:focus-visible .ct {
    transform: translateX(-21px);
  }

  .contact-cta:hover .ca.l,
  .contact-cta:focus-visible .ca.l {
    visibility: hidden;
  }

  .contact-cta:hover .ca.r,
  .contact-cta:focus-visible .ca.r {
    visibility: visible;
  }

  .mobile-toggle,
  .mobile-drawer {
    display: none;
  }

  .mobile-toggle {
    justify-self: end;
    width: 20px;
    height: 14px;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: #fff;
  }

  .mobile-toggle svg {
    display: block;
    width: 20px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  /* Framer swaps the icons instantly, no morph. */
  .mobile-toggle .i-close,
  .menu-open .mobile-toggle .i-open {
    display: none;
  }

  .menu-open .mobile-toggle .i-close {
    display: block;
  }

  /* Framer phone nav: height springs open (k400 d50); links never fade. */
  .mobile-drawer {
    grid-column: 1 / -1;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-menu) var(--ease-menu);
  }

  .menu-open .mobile-drawer {
    grid-template-rows: 1fr;
  }

  .mobile-drawer nav {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  /* Phone Open content-wrapper gap is 32px. */
  .mobile-drawer nav::before {
    content: '';
    height: 32px;
  }

  .mobile-drawer nav :global(a:last-child) {
    margin-bottom: 16px;
  }

  @media (max-width: 900px) {
    .site-nav,
    .contact-cta {
      display: none;
    }

    .site-header {
      grid-template-columns: 1fr auto;
      align-items: center;
      z-index: 50;
      background: var(--bg);
      padding: 16px var(--page-x) 0;
    }

    .menu-open.site-header {
      padding: 16px var(--page-x);
    }

    .wordmark {
      justify-self: start;
      margin-top: 0;
    }

    .wordmark-text {
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }

    .mobile-toggle {
      display: block;
    }

    .mobile-drawer {
      display: grid;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const setOpen = (open: boolean) => {
    header?.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
  // Framer: tapping a mobile link closes the menu.
  document.querySelectorAll('#mobile-menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
