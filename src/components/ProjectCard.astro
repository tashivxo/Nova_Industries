---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  variant?: 'grid' | 'stack';
}

const { project } = Astro.props;
---

<a class="project-card" href={`/project/${project.slug}`}>
  <div class="meta">
    <span class="eyebrow">{project.category}</span>
    <span class="eyebrow year">{project.year}</span>
  </div>
  <div
    class:list={[
      'media',
      {
        'media-top': project.slug === 'free-period' || project.slug === 'better-built',
      },
    ]}
  >
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
  </div>
  <div class="titles">
    <div class="copy">
      <p class="client">{project.client}</p>
      <h3>{project.titleLine2}</h3>
    </div>
    <span class="arrow" aria-hidden="true">↗</span>
  </div>
</a>

<style>
  .project-card {
    display: grid;
    gap: 0.7rem;
    color: inherit;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .meta .eyebrow {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .media {
    overflow: hidden;
    background: #151515;
    aspect-ratio: 400 / 494;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-top img {
    object-position: center top;
  }

  .project-card:hover .media img,
  .project-card:focus-visible .media img {
    transform: scale(1.045);
  }

  .titles {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .titles .client {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .arrow {
    color: var(--accent);
    font-size: 1.2rem;
    line-height: 1;
    transform: translateY(0.35rem);
    transition: transform 0.25s ease;
  }

  .project-card:hover .arrow,
  .project-card:focus-visible .arrow {
    transform: translate(0.12rem, 0.2rem);
  }

  .titles h3 {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .media img {
      transition: none;
    }

    .project-card:hover .media img,
    .project-card:focus-visible .media img {
      transform: none;
    }
  }
</style>
