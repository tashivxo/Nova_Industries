---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  variant?: 'grid' | 'stack';
}

const { project, variant = 'grid' } = Astro.props;
---

<a class:list={['project-card', variant]} href={`/project/${project.slug}`}>
  <div class="media">
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
  </div>
  <div class="meta">
    <span class="eyebrow">{project.category}</span>
    <span class="eyebrow year">{project.year}</span>
  </div>
  <div class="titles">
    <p class="client">{project.client}</p>
    <h3>{project.titleLine2}</h3>
  </div>
</a>

<style>
  .project-card {
    display: grid;
    gap: 0.85rem;
    color: inherit;
  }

  .media {
    overflow: hidden;
    background: #151515;
    aspect-ratio: 16 / 10;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-card:hover .media img {
    transform: scale(1.04);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .titles .client {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .titles h3 {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .stack .media {
    aspect-ratio: 16 / 9;
  }
</style>
