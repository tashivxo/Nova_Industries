---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalCard from '../components/JournalCard.astro';
import { pricingPlans } from '../data/home';
import { getHomepagePosts } from '../data/posts';

// Framer's plan icon is an 80px dot burst: dots along 8 rays, denser for the first plan.
const burst = (step: number) => {
  const dots: string[] = ['<circle cx="40" cy="40" r="1.1" />'];
  for (let ray = 0; ray < 8; ray++) {
    const a = (ray * Math.PI) / 4;
    for (let d = step; d <= 39; d += step) {
      for (const off of ray % 2 === 0 || d < 14 ? [0] : [-0.09, 0.09]) {
        dots.push(`<circle cx="${(40 + Math.cos(a + off) * d).toFixed(1)}" cy="${(40 + Math.sin(a + off) * d).toFixed(1)}" r="1.1" />`);
      }
    }
  }
  return `<svg viewBox="0 0 80 80" width="80" height="80" fill="currentColor" aria-hidden="true">${dots.join('')}</svg>`;
};
const arrow =
  '<svg viewBox="0 0 20.982 20.982" aria-hidden="true"><path d="M 20.981 1.167 L 20.981 16.333 C 20.981 16.978 20.459 17.5 19.814 17.5 C 19.17 17.5 18.648 16.978 18.648 16.333 L 18.648 3.983 L 1.974 20.659 C 1.516 21.097 0.791 21.088 0.342 20.64 C -0.106 20.192 -0.115 19.467 0.322 19.008 L 17 2.333 L 4.648 2.333 C 4.003 2.333 3.481 1.811 3.481 1.167 C 3.481 0.522 4.003 0 4.648 0 L 19.814 0 C 20.124 0 20.421 0.122 20.64 0.341 C 20.859 0.56 20.982 0.857 20.982 1.167 Z" /></svg>';
---

<BaseLayout title="Pricing — Nova Industries" activePath="/pricing">
  <section class="hero section-pad">
    <h1 class="font-display mask"><span class="line" data-appear style="--ay:170;--ad:.3">Pricing</span></h1>
  </section>

  <section class="plans">
    <div class="reveal-shell plans-grid">
      {
        pricingPlans.map((plan, i) => (
          <article class="card" data-appear style="--ay:170;--ad:.5">
            <span class="icon" set:html={burst(i === 0 ? 5 : 6.5)} />
            <h2>{plan.name}</h2>
            <p class="blurb">{plan.blurb}</p>
            <p class="price-row">
              <span class="price" data-count={`${plan.from},${plan.to}`} data-prefix="$">${plan.from}</span>
              <span class="period">{plan.period}</span>
            </p>
            <ul>
              {plan.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a class="cta" href="/contact"><span class="cta-arrow" set:html={arrow} />Get Started</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="journal section-pad">
    <div class="reveal-shell">
      <h2 class="display-lg mask"><span class="line" data-rise>The Journal</span></h2>
      <div class="grid">
        {getHomepagePosts().map((post) => <JournalCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Framer pricing page at 1440: PRICING 180/170 centred at y232; two 616px plans at x40 and x785
     with a hairline between them. main already adds 84px on top, so paddings are Framer's y minus 84. */
  .hero {
    padding-block: 148px 0;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 180px;
    line-height: 170px;
    letter-spacing: -9px;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .plans {
    padding: 94px 40px 126px;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 128px;
  }

  .card {
    position: relative;
  }

  .card + .card::before {
    content: '';
    position: absolute;
    left: -64px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }

  .icon {
    display: block;
    width: 80px;
    height: 80px;
    margin-bottom: 48px;
    color: #c9c9c9;
  }

  .card h2 {
    margin: 0 0 8px;
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: -0.96px;
    text-transform: uppercase;
  }

  .blurb {
    margin: 0 0 36px;
    font-size: 18px;
    line-height: 28px;
  }

  .price-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding-bottom: 23px;
    border-bottom: 1px solid var(--line);
  }

  .price {
    font-size: 64px;
    line-height: 72px;
    font-weight: 600;
    letter-spacing: -6px;
    padding-right: 6px;
  }

  .period {
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
  }

  ul {
    list-style: none;
    margin: 36px 0 56px;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  li {
    position: relative;
    padding-left: 16px;
    font-size: 18px;
    line-height: 28px;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .cta-arrow {
    display: inline-flex;
    width: 11px;
    height: 12px;
    color: var(--accent);
    transition: transform 0.25s ease;
  }

  .cta-arrow :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .cta:hover .cta-arrow {
    transform: translate(2px, -2px);
  }

  .journal {
    padding-block: 3.5rem 2rem;
  }

  .journal h2 {
    margin: 0 0 2.5rem;
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 1199px) {
    h1 {
      font-size: clamp(88px, 15vw, 180px);
      line-height: 0.94;
      letter-spacing: -0.05em;
    }

    .plans-grid {
      column-gap: 64px;
    }

    .card + .card::before {
      left: -32px;
    }
  }

  /* Framer phone: PRICING 88/80 at y98, plans stacked, 20px gutters. */
  @media (max-width: 809px) {
    .hero {
      padding-top: 14px;
    }

    h1 {
      font-size: 88px;
      line-height: 80px;
      letter-spacing: -4.4px;
    }

    .plans {
      padding: 72px 20px 80px;
    }

    .plans-grid,
    .grid {
      grid-template-columns: 1fr;
    }

    .plans-grid {
      row-gap: 24px;
    }

    .card + .card::before {
      display: none;
    }

    .card h2 {
      font-size: 20px;
      line-height: 28px;
      letter-spacing: -0.6px;
    }

    .blurb,
    li {
      font-size: 16px;
      line-height: 24px;
    }

    li::before {
      top: 9px;
    }
  }
</style>
