---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Nova Industries" showFaq={false}>
  <section class="section-pad" style="padding-block:6rem;min-height:50vh">
    <h1 class="font-display" style="font-size:clamp(3rem,10vw,6rem);margin:0">404</h1>
    <p style="color:var(--muted)">Page not found.</p>
    <a href="/" style="text-transform:uppercase;letter-spacing:.12em;font-size:.75rem"
      >Back home</a
    >
  </section>
</BaseLayout>
