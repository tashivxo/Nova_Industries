---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import JournalCard from '../components/JournalCard.astro';
import Reveal from '../components/Reveal';
import {
  projects,
  getHomepagePosts,
  partnerMetricGroups,
  homeHeroStats,
  skillPairs,
  processSteps,
} from '../data';
---

<BaseLayout title="Nova Industries — Design Agency" activePath="/">
  <section class="hero-pin" data-hero>
    <div class="hero crosshair" data-hero-sticky>
      <div class="hero-lockup">
        <p class="we-are">WE ARE</p>
        <h1 class="display-hero">Design</h1>
        <div class="hero-slot" data-hero-slot>
          <div class="hero-media" data-hero-media>
            <video
              src="/images/hero/hero-loop.mp4"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Studio motion reel"
            ></video>
          </div>
        </div>
        <h1 class="display-hero agency">Agency</h1>
        <p class="for-tech">For tech brands</p>
      </div>
      <div class="hero-stats">
        {
          homeHeroStats.map((s) => (
            <div>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
      <p class="hero-copy">
        We don’t believe in one-size-fits-all solutions. Every brand has its own story.
        Our job is to align strategy.
      </p>
    </div>
  </section>

  <section class="impact section-pad">
    <Reveal client:visible className="reveal-shell">
      <h2>Partnering with startups and tech teams shaping the future.</h2>
      <div class="metrics">
        {
          partnerMetricGroups.map((group) => (
            <article class="metric-card">
              <div class:list={['partner-logo-wrap', group.logoClass]}>
                {
                  group.logoClass === 'logo-swag' ? (
                    <span class="partner-word">{group.name}</span>
                  ) : (
                    <img class="partner-logo" src={group.logo} alt={group.name} />
                  )
                }
              </div>
              <div class="pair">
                {group.stats.map((m) => (
                  <div>
                    <p class="font-display value">{m.value}</p>
                    <p class="label">{m.label}</p>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </Reveal>
  </section>

  <section class="featured section-pad">
    <Reveal client:visible className="reveal-shell">
      <div class="featured-head">
        <h2 class="display-lg">
          <span>featured</span>
          <span>works</span>
        </h2>
      </div>
      <div class="stagger-grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </Reveal>
  </section>

  <section class="skills section-pad">
    <Reveal client:visible className="reveal-shell">
      <h2 class="display-lg">our core skills</h2>
      <div class="skills-body">
        <p class="skills-copy left">
          Creative and digital solutions designed for modern brands and tech startups.
        </p>
        <div class="skill-list">
          {
            skillPairs.map((pair) => (
              <div class="skill">
                <h3>{pair.a}</h3>
                {pair.image ? <img class="skill-thumb" src={pair.image} alt="" /> : <span class="skill-gap" />}
                <h3>{pair.b}</h3>
              </div>
            ))
          }
        </div>
        <p class="skills-copy right">
          We provide creative services to help brands communicate, move faster & stand out.
          Our work supports growth, consistency & brand value.
        </p>
      </div>
    </Reveal>
  </section>

  <section class="testimonial section-pad">
    <Reveal client:visible className="reveal-shell">
      <div class="quote-row">
        <img src="/images/ui/testimonial.jpg" alt="Neatian Meyal" />
        <div>
          <blockquote>
            Before joining Be-tech, I was just going through the motions. Now, I'm part of a team
            that's genuinely changing the world. The support here is incredible.
          </blockquote>
          <div class="person">
            <p class="name">Neatian Meyal</p>
            <p class="role">Head of Product, SaaS Company</p>
          </div>
        </div>
      </div>
    </Reveal>
  </section>

  <section class="process section-pad">
    <Reveal client:visible className="reveal-shell">
      <div class="process-board">
        <p class="eyebrow process-label">name of our processes.</p>
        <div class="process-visual">
          <img class="chart" src="/images/ui/process-chart.svg" alt="" />
          <div class="steps">
            {
              processSteps.map((s) => (
                <article>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </article>
              ))
            }
          </div>
          <span class="origin" aria-hidden="true">0</span>
        </div>
        <div class="timeline">
          <p class="eyebrow">progress & timeline</p>
          <p class="timeline-copy">
            A structured, flexible process built for fast moving startups and modern brands.
          </p>
        </div>
      </div>
    </Reveal>
  </section>

  <section class="journal section-pad">
    <Reveal client:visible className="reveal-shell">
      <h2 class="display-lg">The Journal</h2>
      <div class="journal-grid">
        {
          getHomepagePosts().map((post, i) => (
            <div class:list={['journal-item', { drop: i === 1 }]}>
              <JournalCard post={post} />
            </div>
          ))
        }
      </div>
    </Reveal>
  </section>
</BaseLayout>

<script>
  const pin = document.querySelector('[data-hero]');
  const sticky = document.querySelector('[data-hero-sticky]');
  const slot = document.querySelector('[data-hero-slot]');
  const media = document.querySelector('[data-hero-media]');
  const reduce = window.matchMedia('(max-width: 900px), (prefers-reduced-motion: reduce)');

  function mix(a, b, p) {
    return a + (b - a) * p;
  }

  function updateHero() {
    if (!pin || !sticky) return;
    if (reduce.matches || !slot || !media) {
      sticky.style.setProperty('--p', '0');
      media?.removeAttribute('style');
      return;
    }
    const range = pin.offsetHeight - window.innerHeight;
    const p = range <= 0 ? 0 : Math.min(1, Math.max(0, -pin.getBoundingClientRect().top / range));
    sticky.style.setProperty('--p', p.toFixed(4));

    const hr = sticky.getBoundingClientRect();
    const sr = slot.getBoundingClientRect();
    const left = mix(sr.left - hr.left, hr.width * 0.07, p);
    const top = mix(sr.top - hr.top, hr.height * 0.102, p);
    const width = mix(sr.width, hr.width * 0.86, p);
    const height = mix(sr.height, hr.height * 0.885, p);
    media.style.position = 'absolute';
    media.style.left = `${left}px`;
    media.style.top = `${top}px`;
    media.style.width = `${width}px`;
    media.style.height = `${height}px`;
    media.style.margin = '0';
    media.style.zIndex = p > 0.02 ? '6' : '3';
  }

  updateHero();
  window.addEventListener('scroll', () => requestAnimationFrame(updateHero), { passive: true });
  window.addEventListener('resize', updateHero);
</script>

<style>
  .hero-pin {
    min-height: 100svh;
  }

  .hero {
    --p: 0;
    min-height: 100svh;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero-lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: max-content;
    max-width: calc(100% - 2rem);
    z-index: 1;
  }

  .we-are,
  .hero-lockup .display-hero,
  .for-tech {
    opacity: calc(1 - var(--p) * 1.35);
  }

  .we-are {
    margin: 0 0 0.15rem;
    align-self: flex-start;
    padding-left: 0.22em;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero-lockup .display-hero {
    margin: 0;
  }

  .for-tech {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-slot {
    width: min(16.5rem, 42vw);
    height: 10.7rem;
    margin: 0.4rem auto 0.55rem;
    position: static;
  }

  .hero-media {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #111;
    z-index: 3;
  }

  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-stats {
    position: absolute;
    left: var(--page-x);
    bottom: 2.35rem;
    display: grid;
    gap: 0.55rem;
    z-index: 4;
    opacity: calc(1 - var(--p) * 1.15);
  }

  .hero-stats div {
    display: grid;
    grid-template-columns: 2.6rem auto;
    gap: 0.7rem;
    align-items: baseline;
  }

  .hero-stats strong {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .hero-stats span {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-copy {
    position: absolute;
    right: var(--page-x);
    bottom: 2.35rem;
    width: min(22rem, 34vw);
    margin: 0;
    text-align: right;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    text-transform: uppercase;
    z-index: 4;
    opacity: calc(1 - var(--p) * 1.15);
  }

  .impact {
    padding-block: 5.5rem 4.5rem;
  }

  .impact h2 {
    max-width: 33rem;
    font-size: clamp(1.85rem, 3.35vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.17;
    margin: 0 0 3rem;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
  }

  .metric-card {
    border-left: 1px solid var(--line);
    padding: 0.15rem 0 0.35rem 1.35rem;
  }

  .partner-logo-wrap {
    height: 1.55rem;
    margin-bottom: 1.85rem;
    display: flex;
    align-items: center;
  }

  .partner-logo {
    display: block;
    height: 1.55rem;
    width: auto;
    object-fit: contain;
    opacity: 0.92;
  }

  .logo-bb .partner-logo {
    height: 2.25rem;
    width: 9.5rem;
    object-fit: contain;
    margin: -0.35rem 0;
  }

  .logo-bx .partner-logo {
    height: 1.35rem;
    width: auto;
    max-width: 9.5rem;
  }

  .logo-swag {
    width: 7.2rem;
    height: 1.55rem;
    overflow: hidden;
  }

  .partner-word {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .metrics .value {
    margin: 0;
    font-size: clamp(2.6rem, 3.6vw, 3.15rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .metrics .label {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .featured {
    padding-block: 3.5rem 5rem;
  }

  .featured-head {
    margin-bottom: 2.75rem;
  }

  .featured-head h2 {
    margin: 0;
    display: grid;
  }

  .skills {
    padding-block: 4.5rem 5rem;
    border-top: 1px solid var(--line);
  }

  .skills h2 {
    margin: 0 0 2.75rem;
  }

  .skills-body {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) auto minmax(10rem, 1fr);
    gap: 2rem 1.5rem;
    align-items: center;
  }

  .skills-copy {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 16.5rem;
  }

  .skills-copy.right {
    justify-self: end;
  }

  .skill-list {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
  }

  .skill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 2.7rem;
  }

  .skill h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.55rem, 2.8vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-transform: none;
  }

  .skill-thumb,
  .skill-gap {
    width: 0;
    height: 2.55rem;
    opacity: 0;
    object-fit: cover;
    flex: 0 0 auto;
    transition:
      width 0.28s ease,
      opacity 0.28s ease;
  }

  .skill:hover .skill-thumb,
  .skill:focus-within .skill-thumb {
    width: 3.15rem;
    opacity: 1;
  }

  .testimonial {
    padding-block: 5rem;
    border-top: 1px solid var(--line);
  }

  .quote-row {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    gap: 1.75rem 2rem;
    align-items: start;
  }

  .quote-row img {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
  }

  blockquote {
    margin: 0;
    max-width: 40rem;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .person {
    margin-top: 1.35rem;
  }

  .name {
    margin: 0;
    font-weight: 600;
  }

  .role {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .process {
    padding-block: 4rem 5rem;
    border-top: 1px solid var(--line);
  }

  .process-board {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(12rem, 18rem);
    gap: 1.25rem 1.5rem;
    align-items: stretch;
  }

  .process-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    margin: 0;
    align-self: start;
    padding-top: 0.5rem;
  }

  .process-visual {
    position: relative;
    min-height: 22rem;
  }

  .chart {
    width: min(100%, 62rem);
    height: auto;
    display: block;
    animation: chart-rise 1.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes chart-rise {
    from {
      clip-path: inset(100% 0 0 0);
      opacity: 0.35;
    }
    to {
      clip-path: inset(0);
      opacity: 1;
    }
  }

  .steps {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
  }

  .steps article {
    position: absolute;
    width: min(11.5rem, 32%);
  }

  .steps article:nth-child(1) {
    left: 16%;
    top: 46%;
  }

  .steps article:nth-child(2) {
    left: 42%;
    top: 24%;
  }

  .steps article:nth-child(3) {
    left: 68%;
    top: 2%;
  }

  .steps h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .steps p,
  .timeline-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
    font-size: 0.85rem;
  }

  .origin {
    position: absolute;
    left: 0;
    bottom: 0.15rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .timeline {
    align-self: end;
    padding-bottom: 1.5rem;
  }

  .journal {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--line);
  }

  .journal h2 {
    margin: 0 0 2rem;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .journal-item.drop {
    transform: translateY(4.25rem);
  }

  @media (min-width: 901px) {
    .hero-pin {
      height: 185vh;
    }

    .hero {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 100svh;
    }
  }

  @media (max-width: 900px) {
    .hero {
      align-content: start;
      place-items: stretch;
      padding: 5.25rem var(--page-x) 2.5rem;
      min-height: 100svh;
    }

    .hero-lockup {
      width: 100%;
      max-width: none;
    }

    .we-are,
    .hero-lockup .display-hero,
    .for-tech {
      opacity: 1;
    }

    .we-are {
      padding-left: 0.15em;
    }

    .hero-lockup .display-hero {
      font-size: clamp(4.75rem, 22.5vw, 5.5rem);
    }

    .hero-slot {
      width: min(16.5rem, 82%);
      height: auto;
      aspect-ratio: 263 / 171;
      position: relative;
    }

    .hero-media {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      width: 100% !important;
      height: 100% !important;
    }

    .hero-stats,
    .hero-copy {
      position: static;
      width: auto;
      text-align: left;
      opacity: 1;
      margin-top: 1.75rem;
    }

    .hero-copy {
      max-width: 22rem;
      margin-top: 1.5rem;
    }

    .metrics,
    .skills-body,
    .journal-grid,
    .quote-row {
      grid-template-columns: 1fr;
    }

    .journal-item.drop {
      transform: none;
    }

    .process-board {
      grid-template-columns: 1fr;
    }

    .process-label {
      writing-mode: horizontal-tb;
      transform: none;
    }

    .process-visual {
      min-height: 0;
    }

    .chart {
      display: none;
    }

    .steps {
      position: relative;
      inset: auto;
      display: grid;
      gap: 1.25rem;
      margin: 1rem 0;
    }

    .steps article {
      position: static;
      width: auto;
    }

    .origin {
      display: none;
    }

    .skills-copy.right {
      justify-self: start;
    }

    .skill-thumb {
      width: 2.6rem;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chart {
      animation: none;
    }

    .hero-media,
    .hero-lockup,
    .hero-stats,
    .hero-copy {
      opacity: 1;
    }
  }
</style>
