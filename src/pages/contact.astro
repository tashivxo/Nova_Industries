---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal';
import { contact } from '../data/site';
---

<BaseLayout title="Contact — Nova Industries" activePath="/contact">
  <section class="hero section-pad">
    <a class="email" href="#">{contact.contactEmail}</a>
    <p class="eyebrow">Company Email</p>
    <h1 class="font-display">Contact</h1>
    <div class="socials">
      {
        contact.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer">
            {s.label === 'Dribble' ? 'Dribbble' : s.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="form-wrap section-pad">
    <Reveal client:visible className="reveal-shell">
      <form class="form" data-visual-form>
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" />
        </label>
        <label>
          <span>Company</span>
          <input type="text" name="company" autocomplete="organization" />
        </label>
        <label class="full">
          <span>Message</span>
          <textarea name="message" rows="5"></textarea>
        </label>
        <button type="submit">Send message</button>
        <p class="note">Visual form only — submissions are not sent in Phase 1.</p>
      </form>
    </Reveal>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-visual-form]')?.addEventListener('submit', (e) => {
    e.preventDefault();
  });
</script>

<style>
  .hero {
    padding-block: 2.5rem 2.5rem;
  }

  .email {
    display: inline-block;
    font-size: clamp(1.4rem, 4vw, 2.4rem);
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  h1 {
    margin: 1.25rem 0 1.25rem;
    font-size: clamp(4.75rem, 18vw, 13rem);
    line-height: 0.76;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .form-wrap {
    padding-bottom: 3.5rem;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
    max-width: 48rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
  }

  label span {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  textarea {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    padding: 0.55rem 0 0.65rem;
    font: inherit;
    outline: none;
    border-radius: 0;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    border-bottom-color: rgba(255, 255, 255, 0.85);
  }

  textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .full {
    grid-column: 1 / -1;
  }

  button {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 0.25rem;
    background: #fff;
    color: #000;
    border: 0;
    border-radius: 999px;
    padding: 0.75rem 1.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .note {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
