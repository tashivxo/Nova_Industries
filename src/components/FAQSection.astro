---
import { faqs } from '../data/faqs';
---

<section class="faq section-pad" id="faq">
  <div class="faq-head">
    <h2 class="font-display">FAQ</h2>
    <p class="eyebrow">Clear Answers. No Guesswork.</p>
  </div>
  <div class="faq-list">
    {
      faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding-block: 4.5rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .faq-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .faq-head h2 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    margin: 0;
    line-height: 0.9;
  }

  .faq-item {
    border-top: 1px solid var(--line);
  }

  .faq-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  summary::after {
    content: '+';
    flex: 0 0 auto;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 400;
    transition: transform 0.25s ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-item p {
    margin: 0 2rem 1.1rem 0;
    max-width: 42rem;
    color: var(--muted);
    line-height: 1.6;
    font-size: 0.95rem;
  }
</style>
