---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';

const arrow = '<svg viewBox="0 0 11 12"><path d="M1.5 10.5 9.5 2.5M3.5 2.5h6v6" /></svg>';
---

<BaseLayout title="Contact — Nova Industries" activePath="/contact">
  <section class="hero section-pad">
    <a class="email" href={`mailto:${contact.contactEmail}`} data-appear style="--ay:170;--ad:.3">{contact.contactEmail}</a>
    <p class="eyebrow" data-appear style="--ay:170;--ad:.3">Company Email</p>
    <h1 class="font-display mask"><span class="line" data-appear style="--ay:170;--ad:.3">Contact</span></h1>
    <div class="socials" data-appear style="--ay:170;--ad:.3">
      {
        contact.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer">
            {s.label === 'Dribble' ? 'Dribbble' : s.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="form-wrap section-pad">
    <div class="reveal-shell">
      <form class="form" data-visual-form data-appear style="--ay:170;--ad:.3">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" />
        </label>
        <label>
          <span>Company</span>
          <input type="text" name="company" autocomplete="organization" />
        </label>
        <label class="full">
          <span>Message</span>
          <textarea name="message" rows="5"></textarea>
        </label>
        <button type="submit">
          <span class="sa l" aria-hidden="true" set:html={arrow} />
          <span class="st">Send message</span>
          <span class="sa r" aria-hidden="true" set:html={arrow} />
        </button>
        <p class="note">Visual form only — submissions are not sent in Phase 1.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-visual-form]')?.addEventListener('submit', (e) => {
    e.preventDefault();
  });
</script>

<style>
  .hero {
    padding-block: 2.5rem 2.5rem;
  }

  .email {
    display: inline-block;
    font-size: clamp(1.4rem, 4vw, 2.4rem);
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  h1 {
    margin: 1.25rem 0 1.25rem;
    font-size: clamp(4.75rem, 18vw, 13rem);
    line-height: 0.76;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .form-wrap {
    padding-bottom: 3.5rem;
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
    max-width: 48rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
  }

  label span {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  textarea {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    padding: 0.55rem 0 0.65rem;
    font: inherit;
    outline: none;
    border-radius: 0;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    border-bottom-color: rgba(255, 255, 255, 0.85);
  }

  textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .full {
    grid-column: 1 / -1;
  }

  /* Framer Submit Button: arrow swaps sides instantly, label slides 19px (tween .2s). */
  button {
    grid-column: 1 / -1;
    justify-self: start;
    position: relative;
    margin-top: 0.25rem;
    padding: 0 0 0 19px;
    background: transparent;
    color: #fff;
    border: 0;
    border-radius: 10px;
    font: inherit;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
  }

  .st {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .sa {
    position: absolute;
    top: 4px;
    width: 11px;
    height: 12px;
    color: #ff531a;
  }

  .sa :global(svg) {
    display: block;
    width: 11px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .sa.l {
    left: 0;
  }

  .sa.r {
    left: calc(100% - 11px);
    visibility: hidden;
  }

  button:hover .st,
  button:active .st {
    transform: translateX(-19px);
  }

  button:hover .sa.l,
  button:active .sa.l {
    visibility: hidden;
  }

  button:hover .sa.r,
  button:active .sa.r {
    visibility: visible;
  }


  .note {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .form {
      grid-template-columns: 1fr;
    }
  }
</style>
