---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalCard from '../components/JournalCard.astro';
import { pricingPlans } from '../data/home';
import { getHomepagePosts } from '../data/posts';
---

<BaseLayout title="Pricing — Nova Industries" activePath="/pricing">
  <section class="hero section-pad" data-reveal="tween" style="--rdur:.6;--rd:.4;--rt:.5">
    <h1 class="font-display" data-appear style="--ay:170;--ad:.3">Pricing</h1>
  </section>

  <section class="plans section-pad">
    <div class="reveal-shell plans-grid">
      {
        pricingPlans.map((plan) => (
          <article class="card" data-appear style="--ay:170;--ad:.5">
            <h2>{plan.name}</h2>
            <p class="blurb">{plan.blurb}</p>
            <p class="font-display price" data-count={`${plan.from},${plan.to}`} data-prefix="$">${plan.from}</p>
            <p class="period">{plan.period}</p>
            <ul>
              {plan.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <a class="cta" href="/contact">Get Started</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="journal section-pad">
    <div class="reveal-shell">
      <h2 class="font-display mask"><span class="line" data-rise>The Journal</span></h2>
      <div class="grid">
        {getHomepagePosts().map((post) => <JournalCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 2.5rem 1.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(4.75rem, 18vw, 13rem);
    line-height: 0.76;
  }

  .plans {
    padding-block: 1.5rem 3.5rem;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .card {
    border: 1px solid var(--line);
    padding: 1.35rem 1.5rem;
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .card h2 {
    margin: 0;
    font-size: 1.15rem;
  }

  .blurb,
  .period,
  li {
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
    font-size: 0.9rem;
  }

  .price {
    margin: 0.35rem 0 0;
    font-size: clamp(3rem, 8vw, 5rem);
    line-height: 0.9;
  }

  ul {
    margin: 0.35rem 0 0.75rem;
    padding-left: 1rem;
  }

  li + li {
    margin-top: 0.25rem;
  }

  .cta {
    display: inline-flex;
    justify-content: center;
    padding: 0.75rem 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journal {
    border-top: 1px solid var(--line);
    padding-block: 3.5rem 2rem;
  }

  .journal h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 0.9;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .plans-grid,
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
