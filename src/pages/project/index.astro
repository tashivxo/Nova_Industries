---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout title="Works — Nova Industries" activePath="/project">
  <section class="hero orb-field">
    <div class="lockup">
      <p class="our">Our</p>
      <h1 class="display-hero">
        <span class="line featured">featured</span>
        <span class="line work">work</span>
      </h1>
    </div>
  </section>

  <section class="works section-pad">
    <div class="stagger-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 5.5rem 1rem 3.5rem;
    overflow: hidden;
  }

  .lockup {
    width: max-content;
    max-width: 100%;
  }

  .our {
    width: max-content;
    margin: 0 0 0.2rem 0.22em;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .line {
    display: block;
  }

  .work {
    margin-left: 0.42em;
  }

  .works {
    padding-block: 1rem 8rem;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      place-items: start center;
      padding: 5.25rem 1.15rem 2.25rem;
    }

    .our {
      margin-left: 0.12em;
      font-size: 0.9rem;
    }

    .hero h1 {
      font-size: clamp(4.4rem, 22.5vw, 5.5rem);
    }

    .work {
      margin-left: 0.28em;
    }

    .works {
      padding-block: 0.5rem 4rem;
    }
  }
</style>
