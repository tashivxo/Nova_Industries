---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalCard from '../../components/JournalCard.astro';
import { posts } from '../../data/posts';
---

<BaseLayout title="Blog — Nova Industries" activePath="/blog">
  <section class="hero section-pad">
    <h1 class="font-display mask"><span class="line" data-appear style="--ay:170;--ad:.3">Insights Drive</span></h1>
  </section>

  <section class="list section-pad">
    <div class="reveal-shell">
      {
        posts.map((post) => (
          <a class="row" href={`/blog/${post.slug}`} data-rise>
            <div class="meta">
              <span>{post.readTime}</span>
              <span>{post.dateLabel}</span>
            </div>
            <div class="main">
              <p class="eyebrow">{post.category}</p>
              <h2>{post.title}</h2>
              <p class="author">{post.author}</p>
            </div>
            <div class="thumb">
              <img src={post.image} alt={post.imageAlt} loading="lazy" />
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="more section-pad">
    <h2 class="font-display mask"><span class="line" data-rise>More journal</span></h2>
    <div class="grid">
      {posts.slice(0, 4).map((post) => <JournalCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* Framer blog hero: centred Oswald 140/127 at y232 (64/62 at y98 on phones), clear of the left nav.
     main already adds 84px on top, so paddings here are Framer's y minus 84. */
  .hero {
    padding-block: 148px 40px;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 140px;
    line-height: 127px;
    letter-spacing: -7px;
  }

  @media (max-width: 1199px) {
    h1 {
      font-size: clamp(64px, 11.6vw, 140px);
      line-height: 0.91;
      letter-spacing: -0.05em;
    }
  }

  @media (max-width: 809px) {
    .hero {
      padding-block: 14px 40px;
    }

    h1 {
      font-size: 64px;
      line-height: 62px;
      letter-spacing: -3.2px;
    }
  }

  .list {
    display: grid;
    gap: 0;
    padding-bottom: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 10rem 1fr 6.5rem;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .meta {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .main h2 {
    margin: 0.25rem 0;
    font-size: clamp(1.1rem, 2.4vw, 1.55rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .author {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .thumb {
    aspect-ratio: 1;
    overflow: hidden;
    background: #151515;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .more {
    padding-block: 3.5rem 2rem;
    border-top: 1px solid var(--line);
  }

  .more h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 0.9;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr 5rem;
    }

    .meta {
      grid-column: 1 / -1;
      grid-auto-flow: column;
      justify-content: start;
      gap: 1rem;
    }

    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
