---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  variant?: 'grid' | 'stack';
}

const { project, variant = 'grid' } = Astro.props;
---

<a class:list={['project-card', variant]} href={`/project/${project.slug}`}>
  <div class:list={['media', { 'media-free-period': project.slug === 'free-period' }]}>
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
  </div>
  <div class="meta">
    <span class="eyebrow">{project.category}</span>
    <span class="eyebrow year">{project.year}</span>
  </div>
  <div class="titles">
    <div class="copy">
      <p class="client">{project.client}</p>
      <h3>{project.titleLine2}</h3>
    </div>
    <span class="arrow" aria-hidden="true">↗</span>
  </div>
</a>

<style>
  .project-card {
    display: grid;
    gap: 0.85rem;
    color: inherit;
  }

  .media {
    overflow: hidden;
    background: #151515;
    aspect-ratio: 16 / 10;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-card:hover .media img {
    transform: scale(1.04);
  }

  .media-free-period {
    aspect-ratio: 2.5 / 1;
  }

  .media-free-period img {
    object-position: center top;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .titles {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .titles .client {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .arrow {
    color: var(--accent);
    font-size: 1.15rem;
    line-height: 1;
    transform: translateY(0.15rem);
    transition: transform 0.25s ease;
  }

  .project-card:hover .arrow,
  .project-card:focus-visible .arrow {
    transform: translate(0.12rem, 0.02rem);
  }

  .titles h3 {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .stack .media {
    aspect-ratio: 1.65 / 1;
  }

  .stack .titles h3 {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
  }
</style>
