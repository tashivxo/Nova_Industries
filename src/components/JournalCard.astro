---
import type { Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a class="journal-card" href={`/blog/${post.slug}`}>
  <div class="media">
    <img src={post.image} alt={post.imageAlt} loading="lazy" />
  </div>
  <div class="body">
    <p class="eyebrow">{post.category}</p>
    <h3>{post.title}</h3>
  </div>
</a>

<style>
  .journal-card {
    display: grid;
    gap: 1rem;
  }

  .media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #151515;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .journal-card:hover img {
    transform: scale(1.03);
  }

  .body h3 {
    margin: 0.4rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.2;
    font-weight: 500;
  }
</style>
