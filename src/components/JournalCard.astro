---
import type { Post } from '../data/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a class="journal-card" href={`/blog/${post.slug}`}>
  <div class="media">
    <img src={post.image} alt={post.imageAlt} loading="lazy" />
  </div>
  <div class="body">
    <p class="eyebrow">{post.category}</p>
    <h3>{post.title}</h3>
  </div>
</a>

<style>
  .journal-card {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #151515;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .journal-card:hover img {
    transform: scale(1.03);
  }

  .body h3 {
    margin: 0.35rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
</style>
