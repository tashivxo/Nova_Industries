---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, getProject, getRelatedProjects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProject(slug!);
if (!project) {
  throw new Error(`Unknown project: ${slug}`);
}
const related = getRelatedProjects(project.slug);
---

<BaseLayout title={`${project.title} — Nova Industries`} activePath="/project">
  <section class="hero section-pad">
    <div class="head">
      <h1 class="mask"><span class="line" data-appear style="--ay:170;--ad:.3">{project.title}</span></h1>
      <p class="cat" data-appear style="--ay:170;--ad:.3"><span>{project.category}</span><span>{project.year}</span></p>
    </div>
    <div
      data-appear
      class:list={['media', { 'media-contain': project.imageFit === 'contain' }]}
      style={`--ay:170;--ad:.5;${project.imagePosition ? `--media-pos: ${project.imagePosition}` : ''}`}
    >
      <img src={project.image} alt={project.imageAlt} />
    </div>
  </section>

  <section class="narrative section-pad">
    <h2 data-rise>{project.headline}</h2>
    <p class="intro" data-rise>{project.intro}</p>

    <h3 data-rise>The Challenge</h3>
    <ul data-rise>
      {project.challenges.map((c) => <li>{c}</li>)}
    </ul>

    <h3 data-rise>Our Solution</h3>
    <div class="solutions" data-rise>
      {
        project.solutions.map((s) => (
          <article>
            <h4>{s.title}</h4>
            <ul>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    {
      project.identity && (
        <div class="identity" data-rise>
          <h4>Visual Identity Direction</h4>
          <p>
            <strong>Primary Colors:</strong> {project.identity.colors}
          </p>
          <p>
            <strong>Typography:</strong> {project.identity.typography}
          </p>
          <p>
            <strong>Design Style:</strong> {project.identity.style}
          </p>
        </div>
      )
    }

    {
      project.gallery && project.gallery.length > 0 && (
        <div class="gallery" data-rise>
          <h3>{project.galleryLabel ?? 'Selected frames'}</h3>
          <div class="gallery-grid">
            {project.gallery.map((item) => (
              <figure class:list={{ contain: item.fit === 'contain' }}>
                <img src={item.src} alt={item.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      )
    }
  </section>

  <section class="related section-pad">
    <h2 class="font-display mask"><span class="line" data-rise>Works</span></h2>
    <div class="grid">
      {related.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>

<style>
  /* Framer project page: 1160 column (140 inset at 1440), title at y200, 56/64 Geist, media 1160x664.
     main already adds 84px on top, so paddings here are Framer's y minus 84. */
  .hero,
  .narrative,
  .related {
    padding-inline: max(var(--page-x), calc((100vw - 1160px) / 2));
  }

  .hero {
    padding-block: 116px 2rem;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 24px;
  }

  h1 {
    margin: 0;
    font-size: 56px;
    line-height: 64px;
    font-weight: 600;
    letter-spacing: -2.24px;
    text-transform: uppercase;
    /* uppercase title: drop .mask's descender allowance so the 64px line box matches Framer */
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .cat {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
    text-transform: lowercase;
    white-space: nowrap;
  }

  .media {
    overflow: hidden;
    aspect-ratio: 1160 / 664;
    background: #151515;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--media-pos, center);
  }

  .media-contain img {
    object-fit: contain;
    padding: clamp(1.5rem, 6%, 4rem);
  }

  .narrative {
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  .narrative h2 {
    max-width: 790px;
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: -0.96px;
    margin: 0 0 20px;
  }

  .intro,
  .narrative li,
  .identity p {
    color: var(--muted);
    line-height: 1.6;
  }

  .intro {
    max-width: 790px;
    font-size: 20px;
    line-height: 28px;
  }

  .narrative h3 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.1rem;
  }

  .solutions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
  }

  .solutions h4,
  .identity h4 {
    margin: 0 0 0.5rem;
  }

  .identity {
    margin-top: 2rem;
  }

  .gallery {
    margin-top: 2.5rem;
  }

  .gallery h3 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .gallery-grid figure {
    margin: 0;
    overflow: hidden;
    background: #151515;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 10;
  }

  .gallery-grid figure:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .gallery-grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-grid figure.contain img {
    object-fit: contain;
    padding: 12%;
  }

  .related {
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 0.9;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 809px) {
    .hero {
      padding-top: 0;
    }

    .head {
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 36px;
      line-height: 44px;
      letter-spacing: -1.44px;
    }

    .cat {
      justify-content: flex-end;
      white-space: normal;
    }

    .narrative h2 {
      font-size: 20px;
      line-height: 28px;
      letter-spacing: -0.6px;
    }

    .intro {
      font-size: 16px;
      line-height: 24px;
    }
  }

  @media (max-width: 900px) {
    .solutions,
    .grid,
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
