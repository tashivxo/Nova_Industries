---
import type { Project } from '../data/projects';
import ImageFlip from './ImageFlip.astro';

interface Props {
  project: Project;
  variant?: 'grid' | 'stack';
}

const { project } = Astro.props;
const arrow =
  '<svg viewBox="0 0 20.982 20.982" aria-hidden="true"><path d="M 20.981 1.167 L 20.981 16.333 C 20.981 16.978 20.459 17.5 19.814 17.5 C 19.17 17.5 18.648 16.978 18.648 16.333 L 18.648 3.983 L 1.974 20.659 C 1.516 21.097 0.791 21.088 0.342 20.64 C -0.106 20.192 -0.115 19.467 0.322 19.008 L 17 2.333 L 4.648 2.333 C 4.003 2.333 3.481 1.811 3.481 1.167 C 3.481 0.522 4.003 0 4.648 0 L 19.814 0 C 20.124 0 20.421 0.122 20.64 0.341 C 20.859 0.56 20.982 0.857 20.982 1.167 Z" /></svg>';
---

<a class="project-card" href={`/project/${project.slug}`} data-rise data-scramble-card>
  <div class="meta">
    <span class="eyebrow">{project.category}</span>
    <span class="eyebrow year">{project.year}</span>
  </div>
  <ImageFlip
    src={project.cardImage ?? project.image}
    alt={project.imageAlt}
    class:list={[
      'media',
      {
        'media-top': project.slug === 'free-period' || project.slug === 'betterbuilt',
        'media-contain': project.imageFit === 'contain',
      },
    ]}
    style={project.imagePosition ? `--media-pos: ${project.imagePosition}` : undefined}
  />
  <div class="titles">
    <div class="copy">
      <p class="client" data-scramble>{project.client}</p>
      <h3 data-scramble>{project.titleLine2}</h3>
    </div>
    <span class="arrow" aria-hidden="true"><span class="a-in" set:html={arrow} /><span class="a-out" set:html={arrow} /></span>
  </div>
</a>

<script>
  // Framer card "wave" override: company + title letters flicker through 3 random glyphs
  // (120ms apart) and settle, 36ms per letter, second line 90ms later. Plays 500ms after
  // load and again on every mouseenter.
  const CH = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  const EASE = 'cubic-bezier(0.16,1,0.3,1)';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const raf2 = (fn: () => void) => requestAnimationFrame(() => requestAnimationFrame(fn));
  const set = (el: HTMLElement, t: string, tf: string, op: number) => {
    el.style.transition = t;
    el.style.transform = tf;
    el.style.opacity = String(op);
  };

  function split(el: HTMLElement) {
    const text = el.textContent!.trim();
    el.setAttribute('aria-label', text);
    const inner = document.createElement('span');
    inner.setAttribute('aria-hidden', 'true');
    const letters: { el: HTMLElement; orig: string }[] = [];
    text.split(/( )/).forEach((word) => {
      const w = document.createElement('span');
      w.style.whiteSpace = 'nowrap';
      for (const c of word) {
        const mask = document.createElement('span');
        mask.className = 'cw-mask';
        const l = document.createElement('span');
        l.className = 'cw-letter';
        l.textContent = c === ' ' ? ' ' : c;
        mask.append(l);
        w.append(mask);
        letters.push({ el: l, orig: l.textContent });
      }
      inner.append(w);
    });
    el.replaceChildren(inner);
    return letters;
  }

  for (const card of document.querySelectorAll<HTMLElement>('[data-scramble-card]')) {
    const lines = [...card.querySelectorAll<HTMLElement>('[data-scramble]')].map(split);
    let timers: number[] = [];
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      lines.forEach((chars, li) =>
        chars.forEach(({ el, orig }, ci) => {
          let n = 0;
          const step = () => {
            if (n >= 3) {
              el.textContent = orig;
              set(el, 'none', 'rotateX(-15deg) translateY(4px)', 0);
              raf2(() => set(el, `transform 380ms ${EASE}, opacity 228ms ${EASE}`, 'rotateX(0) translateY(0)', 1));
              return;
            }
            el.textContent = CH[Math.floor(Math.random() * CH.length)];
            set(el, 'none', 'rotateX(-10deg) translateY(2px)', 0.15);
            raf2(() => set(el, `transform 100ms ${EASE}, opacity 100ms ease-out`, 'rotateX(0) translateY(0)', 0.5));
            n++;
            timers.push(window.setTimeout(step, 120));
          };
          timers.push(window.setTimeout(step, li * 90 + ci * 36));
        }),
      );
    };
    if (!reduced) {
      window.setTimeout(play, 500);
      card.addEventListener('mouseenter', play);
    }
  }
</script>

<style>
  .project-card {
    display: grid;
    align-content: start;
    gap: 10px;
    min-width: 0;
    color: inherit;
  }

  .project-card > * {
    min-width: 0;
  }

  /* Framer category row is a fixed 20px line (14/20 Geist medium, #808080, no wrap).
     Longer local categories ellipsize so the year stays put and the card stays 590. */
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    height: 20px;
    overflow: hidden;
  }

  .meta .eyebrow {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: #808080;
    white-space: pre;
  }

  .meta .eyebrow:not(.year) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meta .year {
    flex: 0 0 auto;
  }

  .project-card :global(.media) {
    width: 100%;
    aspect-ratio: 400 / 494;
  }

  .project-card :global(.media-top img) {
    object-position: var(--media-pos, center top);
  }

  .project-card :global(.media-contain img) {
    object-fit: contain;
    padding: clamp(1.25rem, 8%, 3rem);
  }

  .titles {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .titles .client {
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: #808080;
    text-transform: uppercase;
  }

  .titles h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 24px;
    line-height: 32px;
    font-weight: 500;
    letter-spacing: -0.48px;
    text-transform: uppercase;
  }

  /* Two arrows in a 21px clip box: hover sends one out top-right and brings the other in. */
  .arrow {
    position: relative;
    flex: 0 0 auto;
    width: 21px;
    height: 21px;
    margin-right: 4px;
    overflow: hidden;
    color: #ff531a;
  }

  .arrow > span {
    position: absolute;
    inset: 0;
    transition: transform var(--dur-card) var(--ease-card);
  }

  .arrow :global(svg) {
    display: block;
    width: 21px;
    height: 21px;
    fill: currentColor;
  }

  .a-in {
    transform: translate(-48px, 48px);
  }

  .project-card:hover .a-in,
  .project-card:focus-visible .a-in {
    transform: none;
  }

  .project-card:hover .a-out,
  .project-card:focus-visible .a-out {
    transform: translate(60px, -51px);
  }

  .project-card :global(.cw-mask) {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    perspective: 800px;
  }

  .project-card :global(.cw-letter) {
    display: inline-block;
    transform-origin: center 80%;
    backface-visibility: hidden;
  }
</style>
