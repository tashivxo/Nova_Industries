---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';

const arrow = '<svg viewBox="0 0 11 12"><path d="M1.5 10.5 9.5 2.5M3.5 2.5h6v6" /></svg>';
// Framer order: Dribbble, Instagram, LinkedIn, X.
const order = ['Dribble', 'Instagram', 'LinkedIn', 'x'];
const socials = [...contact.socials].sort((a, b) => order.indexOf(a.label) - order.indexOf(b.label));
---

<BaseLayout title="Contact — Nova Industries" activePath="/contact">
  <section class="contact">
    <div class="wrap">
      <div class="left">
        <img
          class="photo"
          src="/images/staging/crosswith/crosswith-02.jpg"
          alt="crosswithswag Kloof Street Nights hoodie, brand work by Nova Industries"
          width="548"
          height="540"
          data-appear
          style="--ay:170;--ad:.3"
        />
        <div class="mail" data-appear style="--ay:170;--ad:.3">
          <a class="email" href={`mailto:${contact.contactEmail}`}>{contact.contactEmail}</a>
          <p class="badge"><span>[</span><span>Company Email</span><span>]</span></p>
        </div>
      </div>

      <div class="right">
        <div class="block">
          <h1 class="title mask"><span class="line" data-appear style="--ay:170;--ad:.3">Contact</span></h1>
          <form class="form" data-visual-form data-appear style="--ay:170;--ad:.3">
            <div class="fields">
              <label>
                <span>Full Name</span>
                <input type="text" name="name" autocomplete="name" placeholder="Your Name" />
              </label>
              <label>
                <span>Email Address</span>
                <input type="email" name="email" autocomplete="email" placeholder="Your Email" />
              </label>
              <label>
                <span>Message</span>
                <textarea name="message" placeholder="Write your Message"></textarea>
              </label>
            </div>
            <button type="submit">
              <span class="sa l" aria-hidden="true" set:html={arrow} />
              <span class="st">Send message</span>
              <span class="sa r" aria-hidden="true" set:html={arrow} />
            </button>
            <p class="note">Visual form only — submissions are not sent in Phase 1.</p>
          </form>
        </div>
        <div class="socials" data-appear style="--ay:170;--ad:.3">
          {
            socials.map((s) => (
              <a class="badge" href={s.href} target="_blank" rel="noreferrer">
                <span>[</span>
                <span>{s.label === 'Dribble' ? 'Dribbble' : s.label}</span>
                <span>]</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-visual-form]')?.addEventListener('submit', (e) => {
    e.preventDefault();
  });
</script>

<style>
  /* Numbers measured off the Framer contact page. main already pads 84px, so the
     top paddings are Framer's content y (232 / 216 / 98) minus 84. */
  .contact {
    padding: 148px max(20px, (100% - 1360px) / 2) 0;
  }

  .wrap {
    display: flex;
    align-items: flex-start;
    gap: 72px;
  }

  .left,
  .right {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .left {
    gap: 50px;
  }

  .photo {
    width: 548px;
    height: 540px;
    max-width: none;
    object-fit: cover;
    object-position: center 78%;
  }

  .mail {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .email {
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .badge {
    display: flex;
    gap: 2px;
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .right {
    gap: 100px;
  }

  .block {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 58px;
  }

  .title {
    margin-top: 0; /* keep .mask's negative bottom margin */
    font-family: var(--font-display);
    font-size: 120px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .form {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 60px;
  }

  .fields {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label span {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--nav);
  }

  input,
  textarea {
    display: block;
    width: 100%;
    background: #1a1a1a;
    border: 0;
    border-radius: 0;
    padding: 11px 20px;
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    color: #fff;
    outline: none;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--nav);
    opacity: 1;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.4);
  }

  textarea {
    height: 100px;
    min-height: 100px;
    resize: vertical;
  }

  /* Framer Submit Button: arrow swaps sides instantly, label slides 19px (tween .2s). */
  button {
    position: relative;
    padding: 0 0 0 19px;
    background: transparent;
    color: #fff;
    border: 0;
    border-radius: 10px;
    font: inherit;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
  }

  .st {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .sa {
    position: absolute;
    top: 4px;
    width: 11px;
    height: 12px;
    color: #ff531a;
  }

  .sa :global(svg) {
    display: block;
    width: 11px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .sa.l {
    left: 0;
  }

  .sa.r {
    left: calc(100% - 11px);
    visibility: hidden;
  }

  button:hover .st,
  button:active .st {
    transform: translateX(-19px);
  }

  button:hover .sa.l,
  button:active .sa.l {
    visibility: hidden;
  }

  button:hover .sa.r,
  button:active .sa.r {
    visibility: visible;
  }


  /* Not in Framer: hangs under the button without moving anything. */
  .note {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    color: var(--nav);
  }

  .socials {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    gap: 26px;
  }

  .socials .badge {
    gap: 4px;
    color: var(--nav);
    transition: color 0.2s ease;
  }

  .socials .badge:hover {
    color: #fff;
  }

  /* Framer tablet: fixed 750 column, 320 image + 398 form. */
  @media (max-width: 1199px) {
    .contact {
      padding: 132px 20px 0;
    }

    .wrap {
      max-width: 750px;
      margin-inline: auto;
      gap: 32px;
    }

    .left {
      flex: 0 0 320px;
    }

    .photo {
      width: 320px;
      height: 315px;
    }

    .email {
      font-size: 26px;
      line-height: 34px;
    }

    .right {
      gap: 64px;
    }

    .block {
      gap: 32px;
    }

    .title {
      font-size: 80px;
      line-height: 1;
    }

    .form {
      gap: 47px;
    }

    .socials {
      justify-content: center;
      gap: 20px;
    }
  }

  /* Framer phone: fixed 350 column, form first, image and email after. */
  @media (max-width: 809px) {
    .contact {
      padding: 14px 16px 0;
    }

    .wrap {
      flex-direction: column;
      max-width: 350px;
      gap: 48px;
    }

    .left,
    .right {
      flex: none;
      width: 100%;
    }

    .right {
      order: -1;
      gap: 32px;
    }

    .title {
      font-size: 52px;
    }

    .fields {
      gap: 24px;
    }

    .form {
      gap: 32px;
    }

    .note {
      top: calc(100% + 6px);
    }

    .socials {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 24px;
    }

    .left {
      gap: 24px;
    }

    .photo {
      width: 100%;
      height: auto;
      aspect-ratio: 350 / 345;
    }

    .email {
      font-size: 20px;
      line-height: 28px;
    }
  }
</style>
