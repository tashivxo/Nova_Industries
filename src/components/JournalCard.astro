---
import type { Post } from '../data/posts';
import ImageFlip from './ImageFlip.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a class="journal-card" href={`/blog/${post.slug}`}>
  <ImageFlip src={post.image} alt={post.imageAlt} class="media" />
  <div class="body">
    <p class="eyebrow">{post.category}</p>
    <h3>{post.title}</h3>
  </div>
</a>

<style>
  .journal-card {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .journal-card :global(.media) {
    aspect-ratio: 3 / 4;
  }

  .body h3 {
    margin: 0.35rem 0 0;
    font-family: var(--font-sans);
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
</style>
