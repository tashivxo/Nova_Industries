---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import JournalCard from '../components/JournalCard.astro';
import {
  projects,
  getHomepagePosts,
  partnerMetricGroups,
  homeHeroStats,
  skillPairs,
  processSteps,
  testimonials,
} from '../data';

// Framer skills scrub (desktop): each row swells as marker i crosses mid-screen, shrinks by marker i+1.
const SKILL_PEAK_X = [[-69, 73], [-40, 44], [-57, 54], [-37, 47], [-44, 44], [-40, 64]];
const skillKeys = (i: number, rest: Record<string, number>, peak: Record<string, number>) =>
  JSON.stringify([
    { at: `#skill-m${i}`, edge: 'top', th: 0.5, v: rest },
    { at: `#skill-m${i}`, th: 0.5, v: peak },
    { at: `#skill-m${i + 1}`, th: 0.5, v: rest },
  ]);
---

<BaseLayout title="Nova Industries — Design Agency" activePath="/">
  <section class="hero-section">
    <div class="hero">
      <div class="hero-bg crosshair" data-appear style="--as:0;--ad:.1" aria-hidden="true"></div>
      <div class="hero-lockup">
        <p class="we-are" data-appear style="--ay:100;--ad:.1">WE ARE</p>
        <h1 class="display-hero" data-appear style="--ay:170;--ad:.3">Design</h1>
        <div class="hero-slot">
          <div class="hero-media" data-appear style="--ay:170;--ad:.3">
            <div
              class="hero-scrub"
              data-scrub-min="1200"
              data-scrub='[{"at":0,"v":{}},{"at":"#hero-m1","v":{"scale":2.2,"y":400}},{"at":"#hero-m2","v":{"scale":3.4,"y":700}},{"at":"#hero-m3","v":{"scale":4.8,"y":1000}},{"at":"#hero-m4","v":{"scale":5.6,"y":1240}}]'
            >
              <video
                src="/images/hero/hero-loop.mp4"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="Studio motion reel"
              ></video>
            </div>
          </div>
        </div>
        <h1 class="display-hero agency" data-appear style="--ay:170;--ad:.7">Agency</h1>
        <p class="for-tech" data-appear style="--ay:100;--ad:.8">For tech brands</p>
      </div>
      <div class="hero-stats" data-appear style="--ay:170;--ad:.9">
        {
          homeHeroStats.map((s) => (
            <div>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
      <p class="hero-copy" data-appear style="--ay:170;--ad:.9">
        <span class="lead">We don’t believe in one-size-fits-all solutions.</span>
        Every brand has its own story. Our job is to align strategy.
      </p>
    </div>
    {[1, 2, 3, 4].map((i) => <span class="hero-marker" id={`hero-m${i}`} style={`--i:${i - 1}`} aria-hidden="true" />)}
  </section>

  <section class="impact section-pad">
      <h2 data-rise>Partnering with startups and tech teams shaping the future.</h2>
      <div class="metrics">
        {
          partnerMetricGroups.map((group) => (
            <article class="metric-card" data-rise>
              <div class:list={['partner-logo-wrap', group.logoClass]}>
                {
                  group.logoClass === 'logo-swag' ? (
                    <span class="partner-word">{group.name}</span>
                  ) : (
                    <img class="partner-logo" src={group.logo} alt={group.name} />
                  )
                }
              </div>
              <div class="pair">
                {group.stats.map((m) => (
                  <div>
                    <p class="font-display value" data-count={`${m.from},${m.to}`} data-suffix={m.suffix}>{m.from}{m.suffix}</p>
                    <p class="label">{m.label}</p>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
  </section>

  <section class="featured section-pad">
      <div class="featured-head">
        <h2 class="display-lg">
          <span class="mask"><span class="line" data-rise>featured</span></span>
          <span class="mask"><span class="line" data-rise="1.4">works</span></span>
        </h2>
      </div>
      <div class="stagger-grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
  </section>

  <section class="skills section-pad">
      <h2 class="display-lg mask"><span class="line" data-rise>our core skills</span></h2>
      <div class="skills-intro" data-rise>
        <p class="skills-copy left">
          Creative and digital solutions designed for modern brands and tech startups.
        </p>
        <p class="skills-copy right">
          We provide creative services to help brands communicate, move faster & stand out.
          Our work supports growth, consistency & brand value.
        </p>
      </div>
      <div class="skill-body">
        <div class="skill-list" data-rise>
          {
            skillPairs.map((pair, i) => (
              <div class="skill">
                <h3 data-scrub-min="1200" data-scrub={skillKeys(i, { x: 58, opacity: 0.6 }, { x: SKILL_PEAK_X[i][0], scale: 1.6 })}>
                  {pair.a}
                </h3>
                <span class="skill-thumb" data-scrub-min="1200" data-scrub={skillKeys(i, { scale: 0, opacity: 0 }, {})}>
                  {pair.image && <img src={pair.image} alt="" />}
                </span>
                <h3 data-scrub-min="1200" data-scrub={skillKeys(i, { x: -58, opacity: 0.6 }, { x: SKILL_PEAK_X[i][1], scale: 1.6 })}>
                  {pair.b}
                </h3>
              </div>
            ))
          }
        </div>
        {skillPairs.concat([skillPairs[0]]).map((_, k) => <span class="skill-marker" id={`skill-m${k}`} style={`--k:${k}`} aria-hidden="true" />)}
      </div>
  </section>

  <section class="testimonial section-pad">
    <div class="t-wrap" data-reveal style="--ry:170;--rd:.3" data-carousel>
      <div class="t-bg" aria-hidden="true">
        <i data-reveal data-reveal-replay style="--rs:0;--rd:.1"></i>
        <i data-reveal data-reveal-replay style="--rs:0;--rd:.1"></i>
      </div>
      {
        testimonials.map((t, i) => (
          <article class="t-card" hidden={i !== 0}>
            <div class="t-img">
              <img src={t.image} alt={t.name} loading="lazy" />
            </div>
            <div class="t-desc">
              <blockquote>{t.quote}</blockquote>
              <div class="person">
                <p class="name">{t.name}</p>
                <p class="role">{t.role}</p>
              </div>
            </div>
          </article>
        ))
      }
      <div class="t-arrows">
        <button type="button" class="t-arrow" data-prev aria-label="Previous testimonial" set:html={'<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>'} />
        <button type="button" class="t-arrow right" data-next aria-label="Next testimonial" set:html={'<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>'} />
      </div>
    </div>
  </section>

  <section class="process section-pad" data-reveal-root data-reveal style="--ry:50;--rd:.2;--rdamp:50">
      <div class="process-wipe" data-reveal="tween" style="--rx:-1400;--ro:1;--rd:.6;--rt:.5" aria-hidden="true"></div>
      <div class="process-board" data-reveal style="--ry:170;--rd:.3">
        <p class="eyebrow process-label">name of our processes.</p>
        <div class="process-visual">
          <img class="chart" src="/images/ui/process-chart.svg" alt="" />
          <div class="steps">
            {
              processSteps.map((s) => (
                <article>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </article>
              ))
            }
          </div>
          <span class="origin" aria-hidden="true">0</span>
        </div>
        <div class="timeline">
          <p class="eyebrow">progress & timeline</p>
          <p class="timeline-copy">
            A structured, flexible process built for fast moving startups and modern brands.
          </p>
        </div>
      </div>
  </section>

  <section class="journal section-pad">
      <h2 class="display-lg mask"><span class="line" data-rise>The Journal</span></h2>
      <div class="journal-grid">
        {
          getHomepagePosts().map((post, i) => (
            <div class:list={['journal-item', { drop: i === 1 }]} data-rise>
              <JournalCard post={post} />
            </div>
          ))
        }
      </div>
  </section>
</BaseLayout>

<script>
  import { animate } from 'motion';

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const cards = [...root.querySelectorAll<HTMLElement>('.t-card')];
    let i = 0;
    const show = (n: number) => {
      cards[i].hidden = true;
      i = (n + cards.length) % cards.length;
      cards[i].hidden = false;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      for (const el of cards[i].querySelectorAll<HTMLElement>('.t-img, .t-desc'))
        animate(el, { opacity: [0, 1], y: [170, 0] }, { type: 'spring', stiffness: 300, damping: 60, delay: 0.3 });
    };
    root.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
  }
</script>

<style>
  /* Framer: hero section clips, hero content does not; the video scales past it. */
  .hero-section {
    position: relative;
    overflow: clip;
  }

  .hero {
    min-height: 100svh;
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Scroll markers for the hero scrub: keyframes fire as each is fully in view. */
  .hero-marker {
    position: absolute;
    left: 0;
    width: 1px;
    height: 300px;
    top: calc(100svh + var(--i) * 324px);
    pointer-events: none;
  }

  .hero-lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: max-content;
    max-width: calc(100% - 2rem);
    z-index: 5;
  }

  .we-are {
    margin: 0 0 0.5rem;
    align-self: flex-start;
    padding-left: 0.22em;
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero-lockup .display-hero {
    margin: 0;
  }

  .for-tech {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .hero-slot {
    width: min(16.5rem, 42vw);
    height: 10.7rem;
    margin: 19px auto 0;
    position: static;
  }

  .hero-media {
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  .hero-scrub {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #111;
  }

  .hero-media video {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
  }

  .hero-stats {
    position: absolute;
    left: var(--page-x);
    bottom: 2.35rem;
    display: grid;
    gap: 0.55rem;
    z-index: 4;
  }

  .hero-stats div {
    display: grid;
    grid-template-columns: 2.6rem auto;
    gap: 0.7rem;
    align-items: baseline;
  }

  .hero-stats strong {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .hero-stats span {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-copy {
    position: absolute;
    right: var(--page-x);
    bottom: 2.35rem;
    width: min(22rem, 34vw);
    margin: 0;
    text-align: right;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.45;
    text-transform: uppercase;
    z-index: 4;
    color: var(--muted);
  }

  .hero-copy .lead {
    color: #fff;
  }

  .impact {
    padding-block: 5.5rem 4.5rem;
  }

  .impact h2 {
    max-width: 33rem;
    font-size: clamp(1.85rem, 3.35vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.17;
    margin: 0 0 3rem;
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
  }

  .metric-card {
    border-left: 1px solid var(--line);
    padding: 0.15rem 0 0.35rem 1.35rem;
  }

  .partner-logo-wrap {
    height: 1.55rem;
    margin-bottom: 1.85rem;
    display: flex;
    align-items: center;
  }

  .partner-logo {
    display: block;
    height: 1.55rem;
    width: auto;
    object-fit: contain;
    opacity: 0.92;
  }

  .logo-bb .partner-logo {
    height: 2.25rem;
    width: 9.5rem;
    object-fit: contain;
    margin: -0.35rem 0;
  }

  .logo-bx .partner-logo {
    height: 1.35rem;
    width: auto;
    max-width: 9.5rem;
  }

  .logo-swag {
    width: 7.2rem;
    height: 1.55rem;
    overflow: hidden;
  }

  .partner-word {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .metrics .value {
    margin: 0;
    font-size: clamp(2.6rem, 3.6vw, 3.15rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .metrics .label {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .featured {
    padding-block: 3.5rem 5rem;
  }

  .featured-head {
    margin-bottom: 2.75rem;
  }

  .featured-head h2 {
    margin: 0;
    display: grid;
  }

  .skills {
    padding-block: 4.5rem 5rem;
    border-top: 1px solid var(--line);
  }

  .skills h2 {
    margin: 0 0 2.4rem;
    text-align: center;
  }

  .skills-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 1.5rem;
    align-items: start;
    margin-bottom: 4.25rem;
  }

  .skills-copy {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 16.5rem;
  }

  .skills-copy.right {
    justify-self: end;
    text-align: left;
  }

  .skill-body {
    position: relative;
  }

  .skill-list {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .skill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    height: 77px;
  }

  .skill h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -1.6px;
    line-height: 46px;
    text-transform: none;
    color: #fff;
  }

  .skill-thumb {
    display: none;
    width: 84px;
    height: 77px;
    flex: 0 0 auto;
    overflow: hidden;
  }

  .skill-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Markers the scrub reads: 100px tall, 124px apart, starting at the first row. */
  .skill-marker {
    position: absolute;
    left: 0;
    width: 1px;
    height: 100px;
    top: calc(var(--k) * 124px);
    pointer-events: none;
  }

  @media (min-width: 1200px) {
    .skill-thumb {
      display: block;
    }
  }

  .testimonial {
    padding-block: 200px 0;
  }

  /* Framer carousel: 1088 wrapper, 940 card (300x344 image + 592 text column, 48 gap). */
  .t-wrap {
    position: relative;
    max-width: 1088px;
    margin-inline: auto;
    padding-bottom: 20px;
  }

  .t-bg {
    position: absolute;
    left: 3px;
    top: 1px;
    width: 780px;
    height: 456px;
    pointer-events: none;
  }

  .t-bg i {
    position: absolute;
    top: 0;
    width: 456px;
    height: 456px;
    border: 1px solid #242424;
    border-radius: 50%;
  }

  .t-bg i:last-child {
    left: 324px;
  }

  .t-card {
    position: relative;
    display: grid;
    grid-template-columns: 300px minmax(0, 592px);
    gap: 48px;
    align-items: center;
    max-width: 940px;
    min-height: 419px;
    margin: 0 auto;
    padding-top: 20px;
  }

  .t-card[hidden] {
    display: none;
  }

  .t-img {
    height: 344px;
    background: var(--bg);
    overflow: hidden;
  }

  .t-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .t-desc blockquote {
    margin: 0 0 82px;
    font-size: 32px;
    line-height: 40px;
    font-weight: 500;
    letter-spacing: -0.96px;
  }

  .t-desc .name {
    margin: 0 0 4px;
    font-size: 28px;
    line-height: 36px;
    font-weight: 500;
    letter-spacing: -0.56px;
    text-transform: uppercase;
  }

  .t-desc .role {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
  }

  .t-arrows {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  /* Hover: fill springs to white (0.4s, bounce 0.2); chevron flips dark instantly. */
  .t-arrow {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid #808080;
    border-radius: 50%;
    background: transparent;
    color: #808080;
    cursor: pointer;
    transition: background-color var(--dur-card) var(--ease-card);
  }

  .t-arrow :global(svg) {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .t-arrow.right :global(svg) {
    transform: rotate(180deg);
  }

  .t-arrow:hover {
    background: #fff;
    color: var(--bg);
  }

  .t-arrow.right:hover {
    border-color: var(--bg);
  }

  .process {
    position: relative;
    overflow: clip;
    padding-block: 4rem 5rem;
    border-top: 1px solid var(--line);
  }

  /* Framer overlay wipe: a page-coloured 2000px block parked 1400px over the chart, then
     tweened off to the right (1.3s, delay .6) once half a screen of the section is visible. */
  .process-wipe {
    position: absolute;
    right: -2000px;
    top: -609px;
    width: 2000px;
    height: 2000px;
    background: var(--bg);
    z-index: 2;
    pointer-events: none;
  }

  .process-board {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(12rem, 18rem);
    gap: 1.25rem 1.5rem;
    align-items: stretch;
  }

  .process-label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    margin: 0;
    align-self: start;
    padding-top: 0.5rem;
  }

  .process-visual {
    position: relative;
    min-height: 22rem;
  }

  .chart {
    width: min(100%, 62rem);
    height: auto;
    display: block;
  }

  .steps {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
  }

  .steps article {
    position: absolute;
    width: min(11.5rem, 32%);
  }

  .steps article:nth-child(1) {
    left: 16%;
    top: 46%;
  }

  .steps article:nth-child(2) {
    left: 42%;
    top: 24%;
  }

  .steps article:nth-child(3) {
    left: 68%;
    top: 2%;
  }

  .steps h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .steps p,
  .timeline-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
    font-size: 0.85rem;
  }

  .origin {
    position: absolute;
    left: 0;
    bottom: 0.15rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .timeline {
    align-self: end;
    padding-bottom: 1.5rem;
  }

  .journal {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--line);
  }

  .journal h2 {
    margin: 0 0 2.75rem;
    text-align: center;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .journal-item.drop {
    margin-top: 4.25rem;
  }

  @media (min-width: 901px) {
    /* Framer's lockup sits 50px above centre (WE ARE at y109 in a 900px hero). */
    .hero-lockup {
      position: relative;
      top: -50px;
    }
  }

  @media (min-width: 1200px) {
    .hero-section {
      height: calc(100svh + 1272px);
    }
  }

  @media (max-width: 900px) {
    .testimonial {
      padding-block: 100px 0;
    }

    .t-bg {
      display: none;
    }

    .t-card {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .t-desc blockquote {
      margin-bottom: 40px;
      font-size: 24px;
      line-height: 32px;
    }

    .t-wrap {
      padding-bottom: 48px;
    }

    .hero {
      align-content: start;
      place-items: stretch;
      padding: 5.25rem var(--page-x) 2.5rem;
      min-height: 100svh;
    }

    .hero-lockup {
      width: 100%;
      max-width: none;
      align-items: flex-start;
    }

    .we-are {
      padding-left: 0.15em;
    }

    .hero-lockup .display-hero {
      font-size: clamp(4.75rem, 22.5vw, 5.5rem);
    }

    .hero-slot {
      width: 100%;
      height: auto;
      aspect-ratio: 263 / 171;
      position: relative;
    }

    .hero-media {
